{% extends 'base.html' %}
{% load static %}

{% block title %}Cars Empire - Home{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<style>
    #merchant-map {
        height: 400px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        display: block;
        position: relative;
        background: #eaeaea;
        border-radius: 12px;
        overflow: hidden;
    }
    .category-card {
        transition: transform 0.2s;
    }
    .category-card:hover {
        transform: translateY(-5px);
    }
    .merchant-popup {
        min-width: 200px;
    }
    .error-message {
        color: #dc3545;
        text-align: center;
        padding: 1rem;
        margin: 1rem 0;
        border: 1px solid #dc3545;
        border-radius: 4px;
        background-color: #f8d7da;
    }
    .loading-spinner {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
    }
    .col-md-9 {
        width: 75%;
        max-width: 75%;
        min-width: 0;
        padding-right: 0 !important;
        overflow: hidden;
        display: block;
    }
    .map-wrapper {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 400px;
        overflow: hidden;
        border-radius: 12px;
        background: #eaeaea;
        position: relative;
        display: block;
    }
    #merchant-map {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 1;
        border-radius: 12px;
    }
    .category-circle {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #eee;
        margin: 0 auto 10px auto;
        display: block;
        background: #fff;
    }
    .category-card {
        text-align: center;
        border: none;
        background: transparent;
        box-shadow: none;
        cursor: pointer;
        transition: box-shadow 0.2s;
    }
    .category-card:hover {
        box-shadow: 0 0 0 4px #eaeaea;
    }
    .category-link {
        text-decoration: none;
        color: inherit;
    }
    .swiper {
        width: 100%;
        padding-bottom: 2rem;
    }
    .swiper-slide {
        display: flex;
        justify-content: center;
        align-items: center;
        height: auto;
    }
</style>
{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="hero bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1>Welcome to Cars Empire</h1>
                <p class="lead">Find the best deals and services for your car in one place.</p>
                <a href="{% url 'deals' %}" class="btn btn-light btn-lg">Explore Deals</a>
            </div>
            <div class="col-md-6">
                <img src="{% static 'images/hero-image.jpg' %}" alt="Cars Empire" class="img-fluid rounded">
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories mb-5">
    <div class="container">
        <h2 class="text-center mb-4">Browse by Category</h2>
        <div class="swiper categories-swiper">
            <div class="swiper-wrapper" id="categories-container">
                <div class="swiper-slide">
                    <div class="loading-spinner">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Add Arrows -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </div>
</section>

<!-- Merchant Map Section -->
<section class="merchant-map mb-5" style="margin-bottom: 5rem; padding-bottom: 4rem;">
    <div class="container">
        <h2 class="text-center mb-4">Find Merchants Near You</h2>
        <div class="row">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Filter Merchants</h5>
                        <div class="mb-3">
                            <label for="category-filter" class="form-label">Category</label>
                            <select class="form-select" id="category-filter">
                                <option value="">All Categories</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="radius-filter" class="form-label">Radius (km)</label>
                            <input type="range" class="form-range" id="radius-filter" min="1" max="100" value="50">
                            <span id="radius-value">50 km</span>
                        </div>
                        <button class="btn btn-primary w-100 mb-3" id="use-location">
                            <i class="fas fa-location-dot"></i> Use My Location
                        </button>
                        <button class="btn btn-outline-primary w-100" id="update-merchants">Update Map</button>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="map-wrapper">
                  <div id="merchant-map"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CSS override to prevent map overlap -->
<style>
#merchant-map, .merchant-map, .merchant-map .container {
    position: static !important;
    overflow: visible !important;
    z-index: auto !important;
}
</style>

<!-- Add a clearfix and extra margin before Featured Deals -->
<div class="clearfix" style="margin-bottom: 3rem;"></div>

<!-- Featured Deals Section -->
<section class="featured-deals">
    <div class="container">
        <h2 class="text-center mb-4">Featured Deals</h2>
        <div class="row" id="featured-deals-container">
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block extra_js %}
<script src="{% static 'js/utils.js' %}"></script>
<script src="{% static 'js/maps.js' %}"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async () => {
    // Helper function to show error message
    function showError(containerId, message) {
        const container = document.getElementById(containerId);
        container.innerHTML = `<div class="error-message">${message}</div>`;
    }

    // Helper function to show loading spinner
    function showLoading(containerId) {
        const container = document.getElementById(containerId);
        container.innerHTML = `
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        `;
    }

    // Load categories
    try {
        console.log('Loading categories for carousel...');
        const categories = await api.categories.getAllForCarousel();
        console.log('Categories received:', categories);
        
        const categoriesContainer = document.getElementById('categories-container');
        const categoryFilter = document.getElementById('category-filter');
        
        if (!Array.isArray(categories) || categories.length === 0) {
            console.warn('No categories found or invalid response:', categories);
            showError('categories-container', 'No categories found');
            return;
        }

        console.log(`Found ${categories.length} categories`);
        categoriesContainer.innerHTML = ''; // Clear loading spinner
        categoryFilter.innerHTML = '<option value="">All Categories</option>';
        
        // Separate parent and child categories
        const parentCategories = categories.filter(cat => cat.is_parent);
        const childCategories = categories.filter(cat => !cat.is_parent);
        
        console.log(`Parent categories: ${parentCategories.length}, Child categories: ${childCategories.length}`);
        
        // Function to create category HTML
        const createCategoryHTML = (category, isParent = false) => {
            const iconUrl = category.icon ? category.icon : '/static/images/default-category.png';
            
            return `
                <div class="swiper-slide">
                  <a href="/merchants/category/${category.id}/" class="category-link w-100" onclick="console.log('Navigating to category ${category.id}')">
                    <div class="card category-card h-100 position-relative">
                      <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <img src="${iconUrl}" alt="${category.name}" class="category-circle mb-2">
                        <h5 class="card-title mt-2 text-center">${category.name}</h5>
                      </div>
                    </div>
                  </a>
                </div>
            `;
        };
        
        // Add parent categories first
        parentCategories.forEach(category => {
            console.log(`Adding parent category: ${category.name}`);
            categoriesContainer.innerHTML += createCategoryHTML(category, true);
        });
        
        // Add child categories
        childCategories.forEach(category => {
            console.log(`Adding child category: ${category.name}`);
            categoriesContainer.innerHTML += createCategoryHTML(category, false);
        });
        
        // Add all categories to filter dropdown
        categories.forEach(category => {
            const prefix = category.is_parent ? '📁 ' : '  ';
            categoryFilter.innerHTML += `
                <option value="${category.id}">${prefix}${category.name}</option>
            `;
        });
        
        console.log('Categories loaded successfully');
        
        // Initialize Swiper after categories are loaded
        new Swiper('.categories-swiper', {
            slidesPerView: 2,
            spaceBetween: 20,
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                576: { slidesPerView: 3 },
                768: { slidesPerView: 4 },
                992: { slidesPerView: 6 },
                1200: { slidesPerView: 8 }
            }
        });
    } catch (error) {
        console.error('Error loading categories:', error);
        showError('categories-container', 'Failed to load categories');
        handleApiError(error);
    }

    // Load featured deals
    try {
        const deals = await api.deals.getFeatured();
        const dealsContainer = document.getElementById('featured-deals-container');
        
        if (!Array.isArray(deals) || deals.length === 0) {
            // Do not show any message if there are no featured deals
            return;
        }

        dealsContainer.innerHTML = ''; // Clear loading spinner
        
        deals.forEach(deal => {
            if (!deal || !deal.id || !deal.title) {
                console.warn('Invalid deal data:', deal);
                return;
            }

            dealsContainer.innerHTML += `
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">${deal.title}</h5>
                            <p class="card-text">${(deal.description || '').substring(0, 100)}...</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-primary">$${deal.discount_price || 0}</span>
                                <a href="/deals/${deal.slug || deal.id}" class="btn btn-primary">View Deal</a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });
    } catch (error) {
        showError('featured-deals-container', 'Failed to load featured deals');
        handleApiError(error);
    }

    // Setup map filters
    const radiusFilter = document.getElementById('radius-filter');
    const radiusValue = document.getElementById('radius-value');
    const updateButton = document.getElementById('update-merchants');
    const useLocationButton = document.getElementById('use-location');
    let currentLocation = null;

    radiusFilter.addEventListener('input', (e) => {
        radiusValue.textContent = `${e.target.value} km`;
    });

    useLocationButton.addEventListener('click', async () => {
        if (navigator.geolocation) {
            try {
                useLocationButton.disabled = true;
                useLocationButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Getting Location...';
                
                const position = await new Promise((resolve, reject) => {
                    navigator.geolocation.getCurrentPosition(resolve, reject);
                });

                currentLocation = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };

                // Check if map is initialized
                if (window.merchantMap && window.merchantMap.map) {
                    // Center map on user's location
                    window.merchantMap.map.setView([currentLocation.lat, currentLocation.lng], 13);
                    // Update merchants
                    await window.merchantMap.updateNearbyMerchants();
                } else {
                    console.error('Map not initialized');
                    showError('merchant-map', 'Map not initialized. Please refresh the page.');
                }
            } catch (error) {
                console.error('Geolocation error:', error);
                showError('merchant-map', 'Error getting your location: ' + error.message);
            } finally {
                useLocationButton.disabled = false;
                useLocationButton.innerHTML = '<i class="fas fa-location-dot"></i> Use My Location';
            }
        } else {
            showError('merchant-map', 'Geolocation is not supported by your browser');
        }
    });

    async function updateNearbyMerchants() {
        if (!currentLocation) return;
        
        const radius = radiusFilter.value;
        try {
            updateButton.disabled = true;
            updateButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
            
            const merchants = await api.merchants.getNearby(
                currentLocation.lat,
                currentLocation.lng,
                radius
            );
            window.merchantMap.addMerchantMarkers(merchants);
        } catch (error) {
            handleApiError(error);
        } finally {
            updateButton.disabled = false;
            updateButton.innerHTML = 'Update Map';
        }
    }

    updateButton.addEventListener('click', async () => {
        const categoryId = categoryFilter.value;
        try {
            updateButton.disabled = true;
            updateButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
            
            if (categoryId) {
                const merchants = await api.merchants.getByCategory(categoryId);
                window.merchantMap.addMerchantMarkers(merchants);
            } else if (currentLocation) {
                await updateNearbyMerchants();
            } else {
                await window.merchantMap.loadMerchants();
            }
        } catch (error) {
            handleApiError(error);
        } finally {
            updateButton.disabled = false;
            updateButton.innerHTML = 'Update Map';
        }
    });
});
</script>
<script>
setTimeout(function() {
    if (window.merchantMap && window.merchantMap.map) {
        window.merchantMap.map.invalidateSize();
    }
}, 500);
</script>
{% endblock %}
