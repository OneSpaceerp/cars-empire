# Cars Empire Environment Configuration
# Copy this or set these variables in Vercel Project Settings > Environment Variables

# Django Security
SECRET_KEY=your-secure-random-secret-key
DEBUG=False

# Persistent Database (Recommended: Free Neon.tech or Supabase PostgreSQL)
# Example: postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/carsempire?sslmode=require
DATABASE_URL=

# Allowed Hosts (Vercel automatically handles *.vercel.app)
ALLOWED_HOSTS=*
