# CloudLinux Passenger Configuration
PassengerAppRoot "/home/carsempire/repositories/cars_empire/cars_empire_backend"
PassengerBaseURI "/"
PassengerPython "/home/carsempire/virtualenv/repositories/cars_empire/cars_empire_backend/3.10/bin/python"
PassengerStartupFile passenger_wsgi.py
PassengerAppType wsgi
<IfModule Litespeed>
    SetEnv DJANGO_SETTINGS_MODULE cars_empire_project.settings
    SetEnv PYTHONPATH /home/carsempire/repositories/cars_empire/cars_empire_backend
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Handle static files
    RewriteCond %{REQUEST_URI} ^/static/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^static/(.*)$ /home/carsempire/public_html/static/$1 [L]
    # Handle media files
    RewriteCond %{REQUEST_URI} ^/media/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^media/(.*)$ /home/carsempire/public_html/media/$1 [L]
    # Handle all other requests
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ / [QSA,L]
</IfModule>

